{
	"name": "bookbear",
	"version": "1.5.0",
	"description": "Book discovery app combining Wikidata metadata with Wikipedia popularity metrics",
	"author": "Vegard Egeland",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"check": "biome check .",
		"check:fix": "biome check . --write",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"format": "biome format .",
		"format:fix": "biome format . --write",
		"typecheck": "tsc --noEmit",
		"script": "tsx scripts/cli.ts"
	},
	"dependencies": {
		"downshift": "9.4.0",
		"fuse.js": "7.5.0",
		"next": "16.4.3",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@duckdb/node-api": "^2.0.0-r.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"commander": "^15.0.0",
		"csv-parse": "^7.0.3",
		"postcss": "^8.5.32",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^7"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true
	}
}
